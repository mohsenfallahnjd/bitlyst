# Copy to .env.local. Every value is optional for `bun dev` and `bun run build`:
# features whose service is not configured stay empty or return an error.

# Postgres: comments and the admin page
DATABASE_URL=

# Redis: views, reactions and API rate limiting (limits are skipped without it)
REDIS_URL=

# Long random string for /admin, e.g. `openssl rand -base64 32`. Admin stays locked when empty.
ADMIN_SECRET=

# Long random string that salts hashed visitor IPs
VIEWS_SALT=

# Resend: feedback form and newsletter signup
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# dev.to cross-posting (scripts/devto.ts)
DEVTO_API_KEY=
DEVTO_PUBLISH=false
